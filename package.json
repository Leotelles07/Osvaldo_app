{
  "name": "osvaldo-game",
  "version": "1.0.0",
  "private": true,
  "description": "Osvaldo Game - um jogo estilo snake com um dachshund arlequim",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-osvaldo \"vitest run --config vitest.rules.config.ts\"",
    "deploy:firestore": "firebase deploy --only firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-tools": "^15.30.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "firebase": "^11.10.0"
  }
}
