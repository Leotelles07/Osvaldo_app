# Configuração do app web no Firebase (Console → Configurações do projeto →
# Seus apps → Configuração do SDK). Copie para .env.local e preencha.
# São chaves públicas do cliente: não coloque aqui nenhuma chave de servidor.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
